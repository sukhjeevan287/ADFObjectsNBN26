{
	"name": "copy_csv_to_csv_B",
	"properties": {
		"description": "Copy csv file from source(ADLS) to ADLS",
		"activities": [
			{
				"name": "Copy_Csv_Data",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "input//orders.csv"
					},
					{
						"name": "Destination",
						"value": "output//orders_Output"
					}
				],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".csv"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Orders_source",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Orders_Sink",
						"type": "DatasetReference"
					}
				]
			}
		],
		"folder": {
			"name": "Azure Practice_SB/Copy Activity"
		},
		"annotations": [
			"Csv_Copy"
		],
		"lastPublishTime": "2026-11-25T01:48:21Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}